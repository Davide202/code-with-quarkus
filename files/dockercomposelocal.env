### =========================================
### IMPOSTAZIONI JVM E LOGGING
### =========================================
JAVA_OPTS='-Xms256m -Xmx512m'
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_API_CNTCHMNGCONTENTS_ROOT_LOG_LEVEL=INFO
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_API_CNTCHMNGCONTENTS_LOG_LEVEL=DEBUG
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_API_CNTCHMNGCONTENTS_KAFKA_LOG_LEVEL=WARN
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_API_CNTCHMNGCONTENTS_LOG_CONSOLE_ENABLED=true

### =========================================
### KAFKA: BOOTSTRAP SERVERS (Locale PLAINTEXT)
### =========================================
# Puntiamo tutte le properties del bootstrap server al container locale 'kafka:9092'
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_VISUALTEMPLATE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALKEEPALIVE_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALREADY_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

### =========================================
### KAFKA: SECURITY PROTOCOLS (Locale PLAINTEXT)
### =========================================
# Disabilitiamo SASL/SCRAM per l'ambiente locale
MOOVA_IHBINF_INFOMOBILITYCONFIGURATION_EVL_VISUALTEMPLATE_KAFKA_CONSUMER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_IHBINF_INFOMOBILITYCONFIGURATION_EVL_VISUALTEMPLATE_KAFKA_CONSUMER_SASL_MECHANISM=
MOOVA_IHBINF_INFOMOBILITYCONFIGURATION_EVL_VISUALTEMPLATE_KAFKA_CONSUMER_SASL_JAAS_CONFIG=

MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_VISUALTEMPLATE_KAFKA_PRODUCER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_VISUALTEMPLATE_KAFKA_PRODUCER_SASL_MECHANISM=
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_VISUALTEMPLATE_KAFKA_PRODUCER_SASL_JAAS_CONFIG=

MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_SERVICECONFIGURATIONUPDATE_KAFKA_PRODUCER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_SERVICECONFIGURATIONUPDATE_KAFKA_PRODUCER_SASL_MECHANISM=
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_EVL_SERVICECONFIGURATIONUPDATE_KAFKA_PRODUCER_SASL_JAAS_CONFIG=

MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALREADY_KAFKA_CONSUMER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALREADY_KAFKA_CONSUMER_SASL_MECHANISM=
MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALREADY_KAFKA_CONSUMER_SASL_JAAS_CONFIG=

MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALKEEPALIVE_KAFKA_CONSUMER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALKEEPALIVE_KAFKA_CONSUMER_SASL_MECHANISM=
MOOVA_FND_APPLICATIONMONITORING_EVL_SIGNALKEEPALIVE_KAFKA_CONSUMER_SASL_JAAS_CONFIG=

### =========================================
### FND COMMON / SECURITY E SSL
### =========================================
# Disabilitazione controlli SSL/TLS severi per il locale
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_VERIFY_PEER=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_VERIFY_HOST=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_STRICT=false

# Sentinel 'none' per evitare eccezioni di file mancante all'avvio
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_PATH=none
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_PASSWORD=none
MOOVA_FND_CORE_LIB_SPRING_SECURITY_KEYSTORE_PATH=none
MOOVA_FND_CORE_LIB_SPRING_SECURITY_KEYSTORE_PASSWORD=none

# Impostazioni di Sicurezza (Uso del mock locale)
MOOVA_FND_CORE_LIB_SPRING_SECURITY_USE_BEARER_FOR_AUTH=false
MOOVA_FND_CORE_LIB_SPRING_SECURITY_OIDC_TENANT_ENABLED=false
MOOVA_FND_CORE_LIB_SPRING_SECURITY_JWT_SKEW=0

### =========================================
### MOCK API ROUTING
### =========================================
# Dirottiamo le chiamate client verso il container dynamic-mock
MOOVA_FND_CORE_LIB_SPRING_SECURITY_PROFILE_MANAGER_BASE_URL=http://dynamic-mock:8080/profile
MOOVA_IHBINF_INFOMOBILITYCONFIGURATION_API_CNTCHMNGCONTENTS_BASE_URL=http://dynamic-mock:8080/mms/ifmb/configuration/contents/api

### =========================================
### SCHEDULING (QUARTZ)
### =========================================
# Cron corretto per Quarkus/Quartz: uso del '?'
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_API_CNTCHMNGCONTENTS_CRON_EXPRESSION=0 0 20 1/1 * ?
MOOVA_FND_CORE_LIB_SPRING_SECURITY_CACHE_CRON=0 0 23 ? * MON-FRI

### =========================================
### OBSERVABILITY
### =========================================
# Abilitiamo l'invio delle tracce al container Jaeger locale
QUARKUS_OTEL_SDK_DISABLED=false

### =========================================
### VARIE
### =========================================
MOOVA_PIS_INFOMOBILITYDELIVERYENGINE_API_CNTCHMNGCONTENTS_DELIVERY_ENGINE_INSTANCE=DEINST00000000000001
MOOVA_FND_CORE_LIB_SPRING_COMMON_PAGINATION_ELEMENTS_IN_RESPONSE_BODY_ENABLED=false