### =========================================
### IMPOSTAZIONI SERVER E LOGGING
### =========================================
JAVA_OPTS='-Xms256m -Xmx512m -Duser.timezone=UTC'
MOOVA_IHBINL_EFTI_PRC_SERVICESTATUS_LOG_LEVEL=INFO
MOOVA_IHBINL_EFTI_PRC_SERVICESTATUS_ALMAVIVA_LOG_LEVEL=INFO
MOOVA_IHBINL_EFTI_PRC_SERVICESTATUS_ALMAVIVA_FND_LOG_LEVEL=ERROR
MOOVA_IHBINL_EFTI_PRC_SERVICESTATUS_AI_COMMON_REQUEST_FILTER_LOG_LEVEL=ERROR

### =========================================
### KAFKA LOCAL CONFIG (PLAINTEXT)
### =========================================
# Override dei bootstrap server e disabilitazione protocolli di sicurezza (SASL/SSL)[cite: 47, 53]
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_CONSUMER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_PRODUCER_SECURITY_PROTOCOL=PLAINTEXT
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_CONSUMER_SASL_MECHANISM=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_PRODUCER_SASL_MECHANISM=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_CONSUMER_SASL_JAAS_CONFIG=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_PRODUCER_SASL_JAAS_CONFIG=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_CONSUMER_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_PRODUCER_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_CONSUMER_SSL_TRUSTSTORE_PATH=
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_PRODUCER_SSL_TRUSTSTORE_PATH=

# Configurazione Topic (Consumer & Producer)
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_CONSUMER_TOPIC_NAME=ihbinl-freighttransport-evl-freighttransportout
MOOVA_IHBINL_EFTI_EVL_SERVICESTATUS_KAFKA_PRODUCER_TOPIC_NAME=ihbinl-freighttransport-evl-freighttransportout

### =========================================
### DIPENDENZE ESTERNE & MOCK
### =========================================
# Reindirizzamento dell'API Gateway (eFTI Gate) verso il dynamic-mock per le chiamate REST in uscita
MOOVA_FND_GATEWAY_API_APIGATEWAY_BASE_URL=http://dynamic-mock:8080

### =========================================
### SICUREZZA, OAUTH E SSL
### =========================================
# Disabilitazione dell'autenticazione OAuth2 (il servizio usa header pre-auth)[cite: 53]
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_AUTO_CONFIGURATION=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_STRICT=false

# Disabilitazione validazione SSL per chiamate in locale[cite: 47, 53]
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_VERIFY_PEER=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_VERIFY_HOST=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_STRICT=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_PATH=none