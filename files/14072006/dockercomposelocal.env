### =========================================
### IMPOSTAZIONI JVM E LOGGING
### =========================================
JAVA_OPTS='-Xms256m -Xmx512m'
QUARKUS_LOG_LEVEL=INFO
QUARKUS_LOG_CATEGORY__IT_ALMAVIVA__LEVEL=DEBUG

### =========================================
### DATABASE: MARIADB LOCAL
### =========================================
# Allineato alle credenziali e al database 'parity' definiti nel docker-compose.yml
MOOVA_IHBINM_STDINTERFACE_DB_DSRM_DB_USERNAME=root
MOOVA_IHBINM_STDINTERFACE_DB_DSRM_DB_PASSWORD=Ihbinf-RooT745
MOOVA_IHBINM_STDINTERFACE_DB_DSRM_DB_JDBC_URL=jdbc:mariadb://mariadb:3306/parity?autoReconnect=true&useUnicode=true&characterEncoding=UTF-8&allowMultiQueries=true&useSSL=false

### =========================================
### KAFKA LOCAL CONFIG (PLAINTEXT)
### =========================================
# Puntiamo al broker locale configurato nel compose
MOOVA_IHBINM_STDINTERFACE_API_DSRM_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Disabilitiamo la sicurezza SASL_SSL/SCRAM per l'ambiente locale
MOOVA_IHBCUS_TRIPSTATUS_EVL_TRIP_KAFKA_CONSUMER_SASL_MECHANISM=
MOOVA_IHBCUS_TRIPSTATUS_EVL_TRIP_KAFKA_CONSUMER_SASL_JAAS_CONFIG=
MOOVA_IHBCUS_TRIPSTATUS_EVL_TRIP_KAFKA_CONSUMER_SSL_TRUSTSTORE_PATH=
MOOVA_IHBCUS_TRIPSTATUS_EVL_TRIP_KAFKA_CONSUMER_SSL_TRUSTSTORE_PASSWORD=

### =========================================
### FND COMMON / SECURITY E SSL
### =========================================
# Disabilitazione controlli SSL/TLS severi per il locale
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_VERIFY_PEER=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_VERIFY_HOST=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_STRICT=false
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_STRICT=false

# Sentinel 'none' per evitare eccezioni di file mancante all'avvio
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_PATH=none
MOOVA_FND_CORE_LIB_SPRING_COMMON_SSL_TRUSTSTORE_PASSWORD=none
MOOVA_FND_CORE_LIB_SPRING_SECURITY_KEYSTORE_PATH=none
MOOVA_FND_CORE_LIB_SPRING_SECURITY_KEYSTORE_PASSWORD=none

### =========================================
### MOCK API ROUTING
### =========================================
# Dirottiamo le chiamate ai servizi esterni verso il container dynamic-mock
MOOVA_FND_GATEWAY_API_APIGATEWAY_BASE_URL=http://dynamic-mock:8080
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_TOKEN_URI=http://dynamic-mock:8080/token

### =========================================
### OBSERVABILITY
### =========================================
# Abilitiamo l'invio delle tracce al container Jaeger locale
QUARKUS_OTEL_SDK_DISABLED=false

### =========================================
### OAUTH2 MOCK CREDENTIALS
### =========================================
# Valori fittizi per la generazione del token (le richieste andranno al mock locale)
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_CLIENT_ID=mock-client-id
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_CLIENT_SECRET=mock-client-secret
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_USERNAME=mock-user
MOOVA_FND_CORE_LIB_SPRING_COMMON_CLIENT_OAUTH2_PASSWORD=mock-password

### =========================================
### DSRM CONFIGURATION
### =========================================
# Valori obbligatori per il dominio DSRM
MOOVA_IHBINM_STDINTERFACE_API_DSRM_AREA_TYPE=urban
MOOVA_IHBINM_STDINTERFACE_API_DSRM_AREA_NUTS_CODE=IT